# ---- Database (required) ----
# Get this free at https://neon.tech  -> create project -> copy the "Connection string"
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---- Sign-in emails ----
# Get a free key at https://resend.com/api-keys
# If you LEAVE THIS BLANK, the app still works: sign-in links are printed to the
# server console instead of emailed. Great for local testing.
RESEND_API_KEY=""

# The "from" address for sign-in emails.
# Resend lets you use onboarding@resend.dev with no setup, but it can ONLY send
# to the email you signed up with. Verify your own domain to email anyone.
EMAIL_FROM="Masjid Ghusl Schedule <onboarding@resend.dev>"

# ---- App settings ----
# Full public URL of the app. Used to build the sign-in links in emails.
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
APP_URL="http://localhost:3000"

# The masjid's local timezone (IANA name). All dates/times display in this zone.
APP_TIMEZONE="America/New_York"

# Name shown in the header and in emails.
MASJID_NAME="Masjid Ghusl Schedule"

# Comma-separated emails that automatically become admins on first sign-in.
ADMIN_EMAILS="you@example.com"

# Country code assumed when someone types a phone number without one.
# "1" = US/Canada, "44" = UK, "92" = Pakistan, "20" = Egypt.
DEFAULT_COUNTRY_CODE="1"


# ---- WhatsApp (all optional) ----
#
# The "Share to WhatsApp" button ALWAYS works and needs nothing configured here:
# it opens WhatsApp with the message pre-written so you can post it to your
# masjid group yourself. Everything below is only for sending automatically to
# each member who opted in.
#
# "none"   — share button only (the default)
# "twilio" — good for testing; recipients must first send "join <code>" to the
#            Twilio sandbox number. NOT for real use.
# "meta"   — production. Needs a verified Meta Business account and an APPROVED
#            message template before a single message will send.
WHATSAPP_PROVIDER="none"

# --- if WHATSAPP_PROVIDER="twilio" ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# The shared sandbox number. Replace once you have your own sender.
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- if WHATSAPP_PROVIDER="meta" ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Name of the template you had approved. It must take four {{n}} variables, in
# this order: date, number of volunteers, note, link.
WHATSAPP_TEMPLATE_NAME="ghusl_day_posted"
WHATSAPP_TEMPLATE_LANG="en"
